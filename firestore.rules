rules_version = '2';

// ASTRO Firestore 보안 규칙
// ⚠️ 아래 ADMIN 이메일 목록을 js/config.js 의 ADMIN_EMAILS 와 똑같이 바꿔 주세요.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function adminEmail() {
      return signedIn() && request.auth.token.email != null
        && request.auth.token.email.lower() in ['admin@example.com'];
    }
    function isAdmin() {
      return signedIn() && (adminEmail() || (exists(me()) && get(me()).data.role == 'admin'));
    }
    function isMember() {
      return signedIn() && (isAdmin() || (exists(me()) && get(me()).data.role == 'member'));
    }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function ownsNew() { return request.resource.data.authorUid == request.auth.uid; }
    function ownsOld() { return resource.data.authorUid == request.auth.uid; }

    // 회원 정보: 본인과 관리자만 읽기. 역할(role)은 관리자만 변경
    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create: if (isSelf(uid) && request.resource.data.role == 'guest') || isAdmin();
      allow update: if isAdmin()
        || (isSelf(uid) && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }

    // 가입 신청서 (문서 ID = 신청자 uid)
    match /applications/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create: if isSelf(uid)
        && request.resource.data.status == 'pending'
        && request.resource.data.adminMemo == '';
      allow update: if isAdmin()
        || (isSelf(uid) && resource.data.status != 'approved'
            && request.resource.data.status == 'pending'
            && request.resource.data.adminMemo == '');
      allow delete: if isAdmin() || (isSelf(uid) && resource.data.status != 'approved');
    }

    // 사이트 설정 · 배너 · 공지: 누구나 읽기, 관리자만 쓰기
    match /settings/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /banners/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /notices/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 활동 기록: 누구나 읽기, 부원 작성, 작성자·관리자 수정/삭제
    match /activities/{id} {
      allow read: if true;
      allow create: if isMember() && ownsNew();
      allow update: if isAdmin() || (isMember() && ownsOld() && ownsNew());
      allow delete: if isAdmin() || (signedIn() && ownsOld());
    }

    // 커뮤니티: 누구나 읽기, 부원 작성
    match /posts/{postId} {
      allow read: if true;
      allow create: if isMember() && ownsNew() && request.resource.data.commentCount == 0;
      allow update: if isAdmin()
        || (isMember() && ownsOld() && ownsNew())
        || (isMember() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount']));
      allow delete: if isAdmin() || (signedIn() && ownsOld());

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isMember() && ownsNew();
        allow delete: if isAdmin()
          || (signedIn() && ownsOld())
          || (signedIn() && get(/databases/$(database)/documents/posts/$(postId)).data.authorUid == request.auth.uid);
      }
    }
  }
}
