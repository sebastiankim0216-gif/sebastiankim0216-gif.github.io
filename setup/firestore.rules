rules_version = '2';

// ASTRO Firestore 보안 규칙 (옛 사이트와 같은 권한 구조)
//   운영담당자(owner): 아래 이메일 목록 — js/config.js 의 OWNER_EMAILS 와 같게 유지
//   관리자(admin): 'admins' 컬렉션 (문서 ID = 이메일, 소문자)

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null && request.auth.token.email != null; }
    function verified() { return signedIn() && request.auth.token.email_verified == true; }
    function myEmail() { return request.auth.token.email.lower(); }
    function isOwner() {
      return verified() && myEmail() in ['yunthomas0120@gmail.com', 'yunarchive0120@gmail.com'];
    }
    function isAdmin() {
      return isOwner() || (verified() && exists(/databases/$(database)/documents/admins/$(myEmail())));
    }
    function mine(d) { return signedIn() && d.authorEmail.lower() == myEmail(); }

    // 관리자 목록: 본인 여부 확인 + 운영담당자만 임명/해제
    match /admins/{email} {
      allow get: if signedIn() && (email == myEmail() || isAdmin());
      allow list: if isAdmin();
      allow write: if isOwner();
    }

    // 설정: apply_questions(지원 질문), site_banner(상단 알림) = 운영담당자
    //       site_content(소개 문구), hero_banners(메인 배너) = 관리자
    match /config/{docId} {
      allow read: if true;
      allow write: if isOwner() || (isAdmin() && docId in ['site_content', 'hero_banners']);
    }

    match /notices/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 가입 신청 (자동 ID, email 필드로 본인 확인)
    match /applications/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.email == myEmail());
      allow create: if signedIn()
        && request.resource.data.email == myEmail()
        && request.resource.data.status == 'pending';
      allow update: if isOwner()
        || (signedIn() && resource.data.email == myEmail()
            && request.resource.data.email == myEmail()
            && resource.data.status == 'pending'
            && request.resource.data.status == 'pending');
      allow delete: if isAdmin()
        || (signedIn() && resource.data.email == myEmail() && resource.data.status == 'pending');
    }

    // 커뮤니티: 로그인하면 누구나 글·댓글, 작성자·관리자 수정/삭제
    match /community_posts/{postId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.authorEmail == myEmail()
        && (request.resource.data.get('isNotice', false) == false || isAdmin());
      allow update: if isAdmin()
        || (mine(resource.data) && request.resource.data.authorEmail == resource.data.authorEmail
            && request.resource.data.get('isNotice', false) == resource.data.get('isNotice', false))
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']);
      allow delete: if isAdmin() || mine(resource.data);

      match /comments/{commentId} {
        allow read: if true;
        allow create: if signedIn() && request.resource.data.authorEmail == myEmail();
        allow delete: if isAdmin() || mine(resource.data)
          || mine(get(/databases/$(database)/documents/community_posts/$(postId)).data);
      }
    }

    // 활동 기록 · 일정: 관리자만 작성
    match /activity_posts/{id} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']);
    }
    match /events/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 개인 설정 (화면 테마)
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
